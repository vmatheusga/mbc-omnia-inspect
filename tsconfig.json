{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "chrome",
      "vite/client"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false
  },
  "exclude": [
    "node_modules",
    ".output",
    "dist",
    "playground"
  ]
}
