{
  "name": "omnia-inspect",
  "description": "Dev Mode para Omnia DS e shadcn/ui: inspecione componentes, variantes, tokens e desvios de padrão direto no Chrome.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
